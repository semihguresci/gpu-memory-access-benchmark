// Experiment 06: AOS Vs SOA
// Shader role: AoS.
// What this experiment tests: AoS versus SoA layout.
// Reading tip: Compare with sibling shaders in this folder; the filename encodes the stage or variant.

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct Particle {
    float px;
    float py;
    float pz;
    float mass;
    float vx;
    float vy;
    float vz;
    float dt;
};

layout(std430, binding = 0) buffer Particles {
    Particle data[];
};

layout(push_constant) uniform Params {
    uint count;
} params;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= params.count) {
        return;
    }

    float px = data[id].px;
    float py = data[id].py;
    float pz = data[id].pz;
    float mass = data[id].mass;
    float vx = data[id].vx;
    float vy = data[id].vy;
    float vz = data[id].vz;
    float dt = data[id].dt;

    data[id].px = px + vx * dt;
    data[id].py = py + vy * dt;
    data[id].pz = pz + vz * dt;
    data[id].mass = mass + 0.000001;
}
