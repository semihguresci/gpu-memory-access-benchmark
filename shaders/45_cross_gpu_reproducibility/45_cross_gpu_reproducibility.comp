// Experiment 45: Cross GPU Reproducibility
// Shader role: main path.
// What this experiment tests: cross-GPU reproducibility under deterministic access patterns.
// Reading tip: This folder has one shader; host-side push constants, input patterns, or memory placement usually select the case.

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// Contract: deterministic source dataset shared across all access modes. The
// experiment changes only how invocations map onto this data, not the payload.
layout(std430, binding = 0) readonly buffer SourceBuffer {
    uint values[];
} source_buffer;

// Contract: one transformed result per dispatched index. Cross-device runs
// compare this buffer to verify that different GPUs preserve the same mapping
// and arithmetic outcome for each configured access pattern.
layout(std430, binding = 1) buffer OutputBuffer {
    uint values[];
} output_buffer;

layout(push_constant) uniform PushConstants {
    uint element_count;
    uint access_mode;
    uint stride;
    uint random_seed;
} push_constants;

uint hash32(uint value) {
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;
    return value;
}

uint resolve_source_index(uint index_value) {
    if (push_constants.access_mode == 1u) {
        return (index_value * push_constants.stride) % push_constants.element_count;
    }
    if (push_constants.access_mode == 2u) {
        return hash32(index_value ^ push_constants.random_seed) % push_constants.element_count;
    }
    return index_value;
}

uint transform_value(uint value, uint index_value) {
    uint state = value ^ (index_value * 0x9e3779b9u);
    state ^= state >> 16u;
    state *= 0x7feb352du;
    state ^= state >> 15u;
    state *= 0x846ca68bu;
    state ^= state >> 16u;
    return state;
}

void main() {
    const uint index_value = gl_GlobalInvocationID.x;
    if (index_value >= push_constants.element_count) {
        return;
    }

    const uint source_index = resolve_source_index(index_value);
    const uint input_value = source_buffer.values[source_index];
    output_buffer.values[index_value] = transform_value(input_value, index_value);
}
