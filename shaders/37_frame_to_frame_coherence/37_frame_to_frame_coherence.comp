// Experiment 37: Frame To Frame Coherence
// Shader role: main path.
// What this experiment tests: frame-to-frame coherence.
// Reading tip: This folder has one shader; host-side push constants, input patterns, or memory placement usually select the case.

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// Contract: stable backing data across frames. The coherence mode remaps which
// source index each invocation reads, but the underlying payload stays fixed.
layout(std430, binding = 0) readonly buffer SourceBuffer {
    uint values[];
} source_buffer;

// Contract: one deterministic result per current-frame invocation so runs can
// compare how temporal remapping changes memory behavior without changing work.
layout(std430, binding = 1) buffer OutputBuffer {
    uint values[];
} output_buffer;

layout(push_constant) uniform PushConstants {
    uint element_count;
    uint frame_index;
    uint coherence_mode;
    uint random_seed;
} push_constants;

uint hash32(uint value) {
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;
    return value;
}

uint resolve_source_index(uint index_value) {
    if (push_constants.coherence_mode == 0u) {
        return (index_value + (push_constants.frame_index * 17u)) % push_constants.element_count;
    }

    if (push_constants.coherence_mode == 1u) {
        const uint block_lane_count = 32u;
        const uint block_base = (index_value / block_lane_count) * block_lane_count;
        const uint lane = index_value % block_lane_count;
        const uint lane_rotated = (lane + push_constants.frame_index) % block_lane_count;
        uint resolved = block_base + lane_rotated;
        if (resolved >= push_constants.element_count) {
            resolved = push_constants.element_count - 1u;
        }
        return resolved;
    }

    return hash32(index_value ^ (push_constants.frame_index * push_constants.random_seed) ^ push_constants.random_seed) %
           push_constants.element_count;
}

void main() {
    const uint index_value = gl_GlobalInvocationID.x;
    if (index_value >= push_constants.element_count) {
        return;
    }

    const uint source_index = resolve_source_index(index_value);
    const uint input_value = source_buffer.values[source_index];

    uint state = input_value ^ (push_constants.frame_index * 0x85ebca6bu) ^ (index_value * 0x9e3779b9u);
    state ^= state >> 16u;
    state *= 0x7feb352du;
    state ^= state >> 15u;
    state *= 0x846ca68bu;
    state ^= state >> 16u;

    output_buffer.values[index_value] = state;
}
