// Experiment 34: Radix Sort GPU
// Shader role: radix sort scatter.
// What this experiment tests: GPU radix-sort pipeline stages.
// Reading tip: Compare with sibling shaders in this folder; the filename encodes the stage or variant.

#version 450

// Scatter pass for radix sort.
// Each workgroup scatters its 256 elements to their globally-sorted positions.
//
// Output position for element i (in block b, with digit d, local rank r):
//   output_pos = digit_starts[d] + block_prefix[d * num_blocks + b] + r
//
// Local rank r is computed by counting same-digit threads with smaller local_id.
// That preserves lane order within each block, making every LSD radix pass stable.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer KeysIn {
    uint values[];
} keys_in;

layout(std430, binding = 1) buffer KeysOut {
    uint values[];
} keys_out;

layout(std430, binding = 2) readonly buffer BlockPrefix {
    uint values[];
} block_prefix; // block_prefix[digit * num_blocks + block]

layout(std430, binding = 3) readonly buffer DigitStarts {
    uint values[];
} digit_starts; // digit_starts[digit]

layout(push_constant) uniform PushConstants {
    uint element_count;
    uint num_blocks;
    uint bit_offset;
    uint radix_mask; // 0xFF for 8-bit, 0x0F for 4-bit
} push_constants;

shared uint local_digits[256];

void main() {
    const uint local_id = gl_LocalInvocationID.x;
    const uint block_id = gl_WorkGroupID.x;
    const uint global_id = gl_GlobalInvocationID.x;

    uint my_key = 0u;
    uint my_digit = 0u;
    const bool in_bounds = global_id < push_constants.element_count;

    // Cache every lane's current radix digit in shared memory so the local-rank
    // computation can inspect earlier lanes without reloading global memory.
    if (in_bounds) {
        my_key = keys_in.values[global_id];
        my_digit = (my_key >> push_constants.bit_offset) & push_constants.radix_mask;
        local_digits[local_id] = my_digit;
    } else {
        local_digits[local_id] = 0xFFFFFFFFu;
    }

    barrier();

    uint local_rank = 0u;
    if (in_bounds) {
        // Count only prior lanes with the same digit. That preserves local lane
        // order inside each digit bucket, which is the stability requirement
        // that makes LSD radix sort correct across multiple passes.
        for (uint prior = 0u; prior < local_id; ++prior) {
            if (local_digits[prior] == my_digit) {
                ++local_rank;
            }
        }
        // Compose the final destination from three pieces:
        // 1) earlier digits, 2) earlier blocks of this digit, 3) earlier lanes
        // in this block with the same digit.
        const uint global_start = digit_starts.values[my_digit];
        const uint block_start = block_prefix.values[my_digit * push_constants.num_blocks + block_id];
        keys_out.values[global_start + block_start + local_rank] = my_key;
    }
}
