// Experiment 34: Radix Sort GPU
// Shader role: radix sort scan.
// What this experiment tests: GPU radix-sort pipeline stages.
// Reading tip: Compare with sibling shaders in this folder; the filename encodes the stage or variant.

#version 450

// Prefix-scan pass for radix sort.
// Launches with exactly 1 workgroup of 256 threads.
// Thread d (0..radix_size-1) sequentially scans across all num_blocks
// for digit d, writing per-block exclusive prefixes into block_prefix.
// After that, a Blelloch inclusive scan over digit_totals shared memory
// computes per-digit global starting offsets (exclusive), written to digit_starts.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Histogram {
    uint values[];
} histogram; // histogram[digit * num_blocks + block]

layout(std430, binding = 1) buffer BlockPrefix {
    uint values[];
} block_prefix; // block_prefix[digit * num_blocks + block]

layout(std430, binding = 2) buffer DigitStarts {
    uint values[];
} digit_starts; // digit_starts[digit]

layout(push_constant) uniform PushConstants {
    uint num_blocks;
    uint radix_size; // 256 for 8-bit, 16 for 4-bit
} push_constants;

// Note: sized for the maximum radix size (8-bit, 256 entries) so this shader
// handles both the 8bit_4pass and 4bit_8pass variants via push_constants.radix_size.
// For 4-bit variants, entries 16-255 are initialised to 0 and contribute 0 to
// the scan, leaving entries 0-15 correct. The extra shared-memory allocation is a
// deliberate trade-off to keep one shader for both digit widths.
shared uint digit_totals[256];

void main() {
    const uint d = gl_LocalInvocationID.x;

    // Phase 1: one lane per digit walks the block histograms for that digit and
    // writes an exclusive prefix for each block. This tells scatter how many
    // same-digit keys appeared in earlier blocks.
    if (d < push_constants.radix_size) {
        uint running = 0u;
        for (uint b = 0u; b < push_constants.num_blocks; ++b) {
            block_prefix.values[d * push_constants.num_blocks + b] = running;
            running += histogram.values[d * push_constants.num_blocks + b];
        }
        // Preserve the full digit population so phase 2 can stack the digit
        // buckets themselves into one global address space.
        digit_totals[d] = running;
    } else {
        digit_totals[d] = 0u;
    }

    barrier();

    // Phase 2: inclusive scan across digit totals. The result answers "how many
    // keys belong to all earlier digits?" so every digit bucket gets a unique
    // global start offset before scatter writes keys out.
    for (uint offset = 1u; offset < 256u; offset <<= 1u) {
        const uint addend = (d >= offset) ? digit_totals[d - offset] : 0u;
        barrier();
        digit_totals[d] += addend;
        barrier();
    }

    // Phase 3: convert the inclusive scan into exclusive digit starts. Digit 0
    // begins at element 0; every later digit starts where the previous digit's
    // total prefix ended.
    if (d < push_constants.radix_size) {
        digit_starts.values[d] = (d == 0u) ? 0u : digit_totals[d - 1u];
    }
}
