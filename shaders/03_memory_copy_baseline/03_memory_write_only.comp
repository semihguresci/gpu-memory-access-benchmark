// Experiment 03: Memory Copy Baseline
// Shader role: memory write only.
// What this experiment tests: read-only, write-only, and copy traffic in isolation.
// Reading tip: Compare with sibling shaders in this folder; the filename encodes the stage or variant.

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) writeonly buffer Destination {
    float values[];
} dst;

layout(push_constant) uniform Params {
    uint element_count;
} params;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= params.element_count) {
        return;
    }

    dst.values[id] = float(id);
}
