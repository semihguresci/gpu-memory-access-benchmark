// Experiment 36: BVH Node Layout
// Shader role: main path.
// What this experiment tests: BVH node layout and traversal locality.
// Reading tip: This folder has one shader; host-side push constants, input patterns, or memory placement usually select the case.

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// Contract: packed BVH node words for the active layout variant. The host sets
// base_word_offset and words_per_node so the shader can reinterpret this same
// backing store as contiguous, padded, or hashed traversal input.
layout(std430, binding = 0) readonly buffer SourceBuffer {
    uint values[];
} source_buffer;

// Contract: one checksum per visited logical node. The output is only used to
// materialize the traversal-style reads and compare layout cost fairly.
layout(std430, binding = 1) buffer OutputBuffer {
    uint values[];
} output_buffer;

layout(push_constant) uniform PushConstants {
    uint node_count;
    uint words_per_node;
    uint layout_mode;
    uint hashed_access_seed;
    uint base_word_offset;
} push_constants;

uint hash32(uint value) {
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;
    return value;
}

uint resolve_source_node(uint node_index) {
    if (push_constants.layout_mode == 2u) {
        return hash32(node_index ^ push_constants.hashed_access_seed) % push_constants.node_count;
    }
    return node_index;
}

uint resolve_word_offset(uint active_word_index) {
    if (push_constants.layout_mode == 1u) {
        return active_word_index * 2u;
    }
    return active_word_index;
}

void main() {
    const uint node_index = gl_GlobalInvocationID.x;
    if (node_index >= push_constants.node_count) {
        return;
    }

    const uint source_node = resolve_source_node(node_index);
    const uint base = push_constants.base_word_offset + (source_node * push_constants.words_per_node);

    uint state = 0x811c9dc5u ^ (node_index * 0x9e3779b9u);
    for (uint word = 0u; word < 8u; ++word) {
        const uint offset = resolve_word_offset(word);
        const uint value = source_buffer.values[base + offset];
        state ^= value + (word * 0x85ebca6bu);
        state = (state << 5u) | (state >> 27u);
        state *= 0xc2b2ae35u;
    }

    output_buffer.values[node_index] = state;
}
