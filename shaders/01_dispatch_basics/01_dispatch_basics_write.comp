// Experiment 01: Dispatch Basics
// Shader role: write.
// What this experiment tests: dispatch overhead versus useful payload work.
// Reading tip: Compare with sibling shaders in this folder; the filename encodes the stage or variant.

#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer Data {
    float values[];
};

void main() {
    uint id = gl_GlobalInvocationID.x;
    values[id] = float(id);
}
