// Experiment 07: AOSOA Blocked Layout
// Shader role: AoS.
// What this experiment tests: AoS, SoA, and AoSoA blocked layout.
// Reading tip: Compare with sibling shaders in this folder; the filename encodes the stage or variant.

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct Particle {
    float px;
    float py;
    float pz;
    float mass;
    float vx;
    float vy;
    float vz;
    float dt;
    float aux0;
    float aux1;
    float aux2;
    float aux3;
    float cold0;
    float cold1;
    float cold2;
    float cold3;
};

layout(std430, binding = 0) buffer Particles {
    Particle data[];
};

layout(push_constant) uniform Params {
    uint count;
} params;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= params.count) {
        return;
    }

    float px = data[id].px;
    float py = data[id].py;
    float pz = data[id].pz;
    float mass = data[id].mass;
    float vx = data[id].vx;
    float vy = data[id].vy;
    float vz = data[id].vz;
    float dt = data[id].dt;
    float aux0 = data[id].aux0;
    float aux1 = data[id].aux1;
    float aux2 = data[id].aux2;
    float aux3 = data[id].aux3;

    float adv_x = vx * dt;
    float adv_y = vy * dt;
    float adv_z = vz * dt;
    px += adv_x;
    py += adv_y;
    pz += adv_z;
    aux0 += (adv_x * 0.5) + (adv_y * 0.25);
    aux1 += adv_z * 0.75;
    aux2 = (aux2 * 0.999) + (aux0 * 0.001);
    aux3 += aux2 * 0.01;
    mass += 0.000001 + (aux1 * 0.0000001);

    data[id].px = px;
    data[id].py = py;
    data[id].pz = pz;
    data[id].mass = mass;
    data[id].aux0 = aux0;
    data[id].aux1 = aux1;
    data[id].aux2 = aux2;
    data[id].aux3 = aux3;
}
