// Experiment 07: AOSOA Blocked Layout
// Shader role: SoA.
// What this experiment tests: AoS, SoA, and AoSoA blocked layout.
// Reading tip: Compare with sibling shaders in this folder; the filename encodes the stage or variant.

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer PosX { float pos_x[]; };
layout(std430, binding = 1) buffer PosY { float pos_y[]; };
layout(std430, binding = 2) buffer PosZ { float pos_z[]; };
layout(std430, binding = 3) buffer Mass { float mass[]; };
layout(std430, binding = 4) buffer VelX { float vel_x[]; };
layout(std430, binding = 5) buffer VelY { float vel_y[]; };
layout(std430, binding = 6) buffer VelZ { float vel_z[]; };
layout(std430, binding = 7) buffer Dt   { float dt[]; };
layout(std430, binding = 8) buffer Aux0 { float aux0[]; };
layout(std430, binding = 9) buffer Aux1 { float aux1[]; };
layout(std430, binding = 10) buffer Aux2 { float aux2[]; };
layout(std430, binding = 11) buffer Aux3 { float aux3[]; };
layout(std430, binding = 12) buffer Cold0 { float cold0[]; };
layout(std430, binding = 13) buffer Cold1 { float cold1[]; };
layout(std430, binding = 14) buffer Cold2 { float cold2[]; };
layout(std430, binding = 15) buffer Cold3 { float cold3[]; };

layout(push_constant) uniform Params {
    uint count;
} params;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= params.count) {
        return;
    }

    float px = pos_x[id];
    float py = pos_y[id];
    float pz = pos_z[id];
    float m = mass[id];
    float vx = vel_x[id];
    float vy = vel_y[id];
    float vz = vel_z[id];
    float time_step = dt[id];
    float a0 = aux0[id];
    float a1 = aux1[id];
    float a2 = aux2[id];
    float a3 = aux3[id];

    float adv_x = vx * time_step;
    float adv_y = vy * time_step;
    float adv_z = vz * time_step;
    px += adv_x;
    py += adv_y;
    pz += adv_z;
    a0 += (adv_x * 0.5) + (adv_y * 0.25);
    a1 += adv_z * 0.75;
    a2 = (a2 * 0.999) + (a0 * 0.001);
    a3 += a2 * 0.01;
    m += 0.000001 + (a1 * 0.0000001);

    pos_x[id] = px;
    pos_y[id] = py;
    pos_z[id] = pz;
    mass[id] = m;
    aux0[id] = a0;
    aux1[id] = a1;
    aux2[id] = a2;
    aux3[id] = a3;
}
