// Experiment 22: Prefix Sum Scan
// Shader role: scan.
// What this experiment tests: hierarchical prefix scan.
// Reading tip: Compare with sibling shaders in this folder; the filename encodes the stage or variant.

#version 450

layout(local_size_x = 256) in;

layout(binding = 0, std430) readonly buffer InputBuffer {
    uint values[];
} input_buffer;

layout(binding = 1, std430) writeonly buffer OutputBuffer {
    uint values[];
} output_buffer;

layout(binding = 2, std430) writeonly buffer BlockTotalsBuffer {
    uint values[];
} block_totals_buffer;

layout(push_constant) uniform PushConstants {
    uint element_count;
    uint block_elements;
    uint block_count;
    uint items_per_thread;
} push_constants;

const uint kMaxScanElements = 3072U;

shared uint scan_ping[kMaxScanElements];
shared uint scan_pong[kMaxScanElements];

void main() {
    const uint local_index = gl_LocalInvocationID.x;
    const uint block_index = gl_WorkGroupID.x;
    // Each workgroup owns one contiguous block of the global array.
    // A later pass will stitch these block-local scans together.
    const uint base_element = block_index * push_constants.block_elements;
    const uint remaining = push_constants.element_count - base_element;
    const uint block_size = min(push_constants.block_elements, remaining);
    const uint stride = gl_WorkGroupSize.x;

    // Load one block into shared memory in a striped pattern so a 256-lane
    // workgroup can cover more than 256 elements. Out-of-range lanes inject 0
    // so the same scan loop handles partial tail blocks safely.
    for (uint item = 0U; item < push_constants.items_per_thread; ++item) {
        const uint shared_index = local_index + (item * stride);
        uint value = 0U;
        if (shared_index < block_size) {
            value = input_buffer.values[base_element + shared_index];
        }
        scan_ping[shared_index] = value;
        scan_pong[shared_index] = 0U;
    }

    barrier();

    // Hillis-Steele style scan across the shared block. The ping/pong buffers
    // avoid read-after-write hazards because each offset step must read the
    // previous iteration's state, not values updated by neighboring lanes in
    // the current iteration.
    bool read_ping = true;
    for (uint offset = 1U; offset < push_constants.block_elements; offset <<= 1U) {
        for (uint item = 0U; item < push_constants.items_per_thread; ++item) {
            const uint shared_index = local_index + (item * stride);
            if (shared_index < block_size) {
                const uint current = read_ping ? scan_ping[shared_index] : scan_pong[shared_index];
                const uint addend =
                    (shared_index >= offset) ? (read_ping ? scan_ping[shared_index - offset]
                                                         : scan_pong[shared_index - offset])
                                             : 0U;
                if (read_ping) {
                    scan_pong[shared_index] = current + addend;
                } else {
                    scan_ping[shared_index] = current + addend;
                }
            }
        }

        barrier();
        read_ping = !read_ping;
    }

    // Write the inclusive scan back to global memory. The last active element
    // in the block is also the block total, which becomes input to the next
    // level of the hierarchical scan on the CPU/GPU orchestration side.
    for (uint item = 0U; item < push_constants.items_per_thread; ++item) {
        const uint shared_index = local_index + (item * stride);
        if (shared_index < block_size) {
            const uint result = read_ping ? scan_ping[shared_index] : scan_pong[shared_index];
            output_buffer.values[base_element + shared_index] = result;
            if (shared_index == (block_size - 1U)) {
                block_totals_buffer.values[block_index] = result;
            }
        }
    }
}
