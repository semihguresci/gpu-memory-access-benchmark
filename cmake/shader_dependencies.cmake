# Track local GLSL include graphs explicitly. This works with both Visual Studio
# and single-configuration generators without depending on depfile support.
function(collect_shader_dependencies shader_file output_variable)
    set(pending "${shader_file}")
    set(dependencies "")
    while(pending)
        list(POP_FRONT pending current_file)
        list(FIND dependencies "${current_file}" existing_index)
        if(NOT existing_index EQUAL -1)
            continue()
        endif()
        list(APPEND dependencies "${current_file}")
        # Reconfigure when include directives change, not only when files are added.
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${current_file}")
        file(STRINGS "${current_file}" include_lines
            REGEX "^[ \t]*#[ \t]*include[ \t]+[\"<]")
        get_filename_component(current_directory "${current_file}" DIRECTORY)
        foreach(include_line IN LISTS include_lines)
            string(REGEX MATCH "include[ \t]+[\"<]([^\">]+)[\">]" include_match "${include_line}")
            if(NOT include_match)
                message(FATAL_ERROR "Unsupported shader include: ${include_line}")
            endif()
            get_filename_component(include_file "${CMAKE_MATCH_1}" ABSOLUTE BASE_DIR "${current_directory}")
            if(NOT EXISTS "${include_file}")
                message(FATAL_ERROR "Shader include not found: ${include_file} (from ${current_file})")
            endif()
            list(APPEND pending "${include_file}")
        endforeach()
    endwhile()
    set(${output_variable} "${dependencies}" PARENT_SCOPE)
endfunction()
